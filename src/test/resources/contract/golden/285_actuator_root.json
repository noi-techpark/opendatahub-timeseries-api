{
  "request" : "GET /actuator [none]",
  "status" : 200,
  "headers" : {
    "cache-control" : "no-cache, no-store, max-age=0, must-revalidate",
    "content-type" : "application/vnd.spring-boot.actuator.v3+json",
    "x-content-type-options" : "nosniff",
    "x-frame-options" : "DENY"
  },
  "body" : {
    "_links" : {
      "health" : {
        "href" : "http://127.0.0.1:<port>/actuator/health",
        "templated" : false
      },
      "health-path" : {
        "href" : "http://127.0.0.1:<port>/actuator/health/{*path}",
        "templated" : true
      },
      "self" : {
        "href" : "http://127.0.0.1:<port>/actuator",
        "templated" : false
      }
    }
  }
}
