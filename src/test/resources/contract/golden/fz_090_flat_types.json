{
  "request" : "GET /flat/*/*?limit=-1&select=tunit,ttype,tmetadata [none]",
  "status" : 200,
  "headers" : {
    "cache-control" : "no-cache, no-store, max-age=0, must-revalidate",
    "content-type" : "application/json;charset=UTF-8",
    "x-content-type-options" : "nosniff",
    "x-frame-options" : "DENY",
    "x-rate-limit-limit" : "1000",
    "x-rate-limit-policy" : "Anonymous"
  },
  "body" : {
    "data" : [ {
      "ttype" : "instantaneous",
      "tunit" : "count"
    }, {
      "ttype" : "mean",
      "tunit" : "C"
    }, {
      "ttype" : "instantaneous"
    }, {
      "tmetadata" : {
        "range" : [ 0, 100 ],
        "scale" : "linear"
      },
      "ttype" : "instantaneous",
      "tunit" : "count"
    }, {
      "ttype" : "total",
      "tunit" : "n"
    } ],
    "limit" : -1,
    "offset" : 0
  }
}
