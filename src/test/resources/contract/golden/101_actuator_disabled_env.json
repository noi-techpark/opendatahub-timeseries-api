    "content-type" : "application/json",
    "x-content-type-options" : "nosniff",
    "x-frame-options" : "DENY",
    "x-rate-limit-limit" : "1000",
    "x-rate-limit-policy" : "Anonymous"
  },
  "body" : {
    "code" : 400,
    "error" : "Bad Request",
